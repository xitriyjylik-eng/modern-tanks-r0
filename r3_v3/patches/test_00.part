--- a/sgdk/tools/test_r3_world.py
+++ b/sgdk/tools/test_r3_world.py
@@ -1,14 +1,26 @@
 #!/usr/bin/env python3
-"""Host-side R3 streaming model. 36,000 ticks = 10 min at 60 logic Hz."""
+"""Host-side R3 streaming + smooth follow model. 36,000 ticks = 10 min at 60 Hz."""
 from pathlib import Path
-import json, hashlib
+import json
 
 WORLD_PX=8192; VIEW_W=224; VIEW_H=192; PLANE_W=64; PLANE_H=32; PREF_L=18; PREF_T=4
-TICKS=36000
+TICKS=36000; FP=8; RESPONSE=3; MAX_STEP=5<<FP; MINIMAP_STEP_TILES=24
 
-cx=cy=WORLD_PX//2
-origin_x=((cx-VIEW_W//2)>>3)-PREF_L
-origin_y=((cy-VIEW_H//2)>>3)-PREF_T
+def smooth(pos,target):
+    delta=target-pos
+    if -8 < delta < 8: return target
+    step=delta>>RESPONSE
+    step=max(-MAX_STEP,min(MAX_STEP,step))

def palette_flat():
    p=SRC_PAL[:192]
    return p+[0]*(768-len(p))
def pimg(w,h,fill=0):
    im=Image.new('P',(w,h),fill); im.putpalette(palette_flat()); return im
def put_tile(atlas,tid,pix,cols):
    x=(tid%cols)*8; y=(tid//cols)*8
    for yy in range(8):
        for xx in range(8): atlas.putpixel((x+xx,y+yy),int(pix[yy][xx] if isinstance(pix[0],list) else pix[yy*8+xx])&15)
def split_put(atlas,base,im,cols,rows,atlas_cols):
    p=im.load()
    for ty in range(rows):
        for tx in range(cols):
            tile=[[p[tx*8+x,ty*8+y] for x in range(8)] for y in range(8)]
            put_tile(atlas,base+ty*cols+tx,tile,atlas_cols)
def unique_tiles(im):
    return len({bytes(im.crop((x,y,x+8,y+8)).getdata()) for y in range(0,im.height,8) for x in range(0,im.width,8)})

def irregular_blob(d, box, fill, seed, points=12):
    x0,y0,x1,y1=box; r=random.Random(seed)
    cx=(x0+x1)/2; cy=(y0+y1)/2; rx=(x1-x0)/2; ry=(y1-y0)/2
    pts=[]
    for i in range(points):
        a=2*math.pi*i/points
        wob=.78+r.random()*.30
        pts.append((int(cx+math.cos(a)*rx*wob),int(cy+math.sin(a)*ry*wob)))
    d.polygon(pts,fill=fill)

world=pimg(WORLD_COLS*8,WORLD_ROWS*8,0)
put_tile(world,BLANK,[[0]*8 for _ in range(8)],WORLD_COLS)

# PAL2: grass / forest floor. Broad readable patches, sparse micro-detail.
for v in range(GRASS_META):
    r=random.Random(1000+v); base=[4,4,5,5,6,3][v%6]
    im=pimg(32,32,base); d=ImageDraw.Draw(im)
    # larger organic shade patches
    for n in range(4):
        x=r.randrange(-4,28); y=r.randrange(-4,28); w=r.randrange(9,20); h=r.randrange(6,14)
        c=r.choice([2,3,5,6,7,8])
        irregular_blob(d,(x,y,x+w,y+h),c,10000+v*10+n,10)
    # small brighter tufts and dark leaf litter
    for _ in range(15):
        x=r.randrange(2,30); y=r.randrange(3,30); c=r.choice([1,2,7,8,9,10])
        d.point((x,y),fill=c)
        if r.random()<.6:d.point((x,y-1),fill=c)
        if r.random()<.25:d.point((x+1,y),fill=c)
    for _ in range(6):
        x=r.randrange(3,29); y=r.randrange(3,29); c=r.choice([9,10,11,12])
        d.rectangle((x,y,x+1,y),fill=c)
    # a few readable grass blades rather than pixel noise
    for _ in range(5):
        x=r.randrange(4,28); y=r.randrange(6,29); c=r.choice([1,2,3])
        d.line((x,y,x-1,y-2),fill=c); d.line((x,y,x+1,y-2),fill=c)
    split_put(world,GRASS_BASE+v*16,im,4,4,WORLD_COLS)


# Current runtime resources only.
IMAGE r2_menu_bg "r2_menu_bg.png" FAST ALL
IMAGE r2_selector "r2_selector.png" FAST ALL

# Approved Map 01 converted to Mega Drive native streamed tile data.
# Conversion is offline-only; runtime never generates the world.
BIN map01_world_tiles "map01_world_tiles.bin" 4 4 0 NONE FALSE
BIN map01_world_tile_palettes "map01_world_tile_palettes.bin" 2 2 0 NONE FALSE
BIN map01_world_palette "map01_world_palette.bin" 2 2 0 NONE FALSE

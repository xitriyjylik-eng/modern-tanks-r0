
from PIL import Image, ImageDraw
import math, random, os

W, H = 320, 224
OUT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'res'))
os.makedirs(OUT, exist_ok=True)

# Four 16-colour CRAM banks, deliberately separated by 8x8 tile ownership.
pals = [
    # PAL0 environment
    [(0,0,0),(6,16,12),(12,35,20),(20,60,28),(31,88,34),(48,122,42),
     (69,50,27),(101,66,34),(16,55,86),(22,88,132),(34,128,177),(74,172,213),
     (120,43,28),(182,64,28),(226,117,36),(235,226,177)],
    # PAL1 logo / steel
    [(0,0,0),(5,10,16),(12,22,31),(24,39,52),(44,62,75),(72,91,104),
     (108,124,134),(153,164,170),(197,204,207),(240,242,239),
     (88,38,18),(145,57,20),(206,79,18),(238,118,22),(255,171,38),(255,225,145)],
    # PAL2 centre UI
    [(0,0,0),(4,9,16),(7,19,31),(10,33,49),(18,49,68),(39,71,91),
     (74,102,118),(118,143,153),(174,190,194),(237,241,234),
     (35,121,72),(48,188,91),(37,114,163),(239,210,48),(180,52,38),(244,115,52)],
    # PAL3 lower HUD / tank cards
    [(0,0,0),(4,9,14),(8,18,27),(15,32,44),(31,55,69),(54,82,94),
     (83,111,120),(126,148,152),(181,195,194),(238,241,229),
     (33,104,58),(46,171,80),(37,101,164),(58,158,214),(210,59,44),(239,183,46)]
]
palette = []
for pal in pals:
    for c in pal: palette.extend(c)
palette += [0,0,0] * (256-64)

def I(p,c): return p*16+c

img = Image.new("P",(W,H),I(0,2))
img.putpalette(palette)
d = ImageDraw.Draw(img)
rng = random.Random(0x4D545232)  # MTR2


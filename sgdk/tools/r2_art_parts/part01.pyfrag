def text_width(s, scale=1, spacing=1):
    if not s: return 0
    return len(s)*(5*scale+spacing)-spacing

def ptext(x,y,s,color,scale=1,spacing=1,shadow=None,shadow_off=(1,1)):
    if shadow is not None:
        ptext(x+shadow_off[0],y+shadow_off[1],s,shadow,scale,spacing,None)

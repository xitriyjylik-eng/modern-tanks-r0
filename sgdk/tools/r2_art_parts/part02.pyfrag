     for gy,row in enumerate(glyph):
            for gx,v in enumerate(row):
                if v=='1':
                    d.rectangle([cx+gx*scale,y+gy*scale,cx+gx*scale+scale-1,y+gy*scale+scale-1],fill=color)
        cx += 5*scale+spacing

def ctext(y,s,color,scale=1,spacing=1,shadow=None):
    ptext((W-text_width(s,scale,spacing))//2,y,s,color,scale,spacing,shadow)

# -------- palette ownership map (per 8x8 tile) --------
owner=[[0 for _ in range(40)] for _ in range(28)]
for ty in range(21,28):
    for tx in range(40): owner[ty][tx]=3
for ty in range(1,9):
    for tx in range(5,35): owner[ty][tx]=1
for ty in range(1,7):
    for tx in range(33,40): owner[ty][tx]=1
for ty in range(9,21):
    for tx in range(12,28): owner[ty][tx]=2

# -------- environment background PAL0 --------
# base per 8x8 tile with deliberately varied texture
for ty in range(21):
    for tx in range(40):
        x,y=tx*8,ty*8
        # grass base
        base = I(0,3 if (tx+ty)%3 else 2)
        d.rectangle([x,y,x+7,y+7],fill=base)
        # individual tuft clusters so the screen doesn't look tiled
        rr=random.Random((tx+1)*1103515245 ^ (ty+17)*12345 ^ 0x7234)
        for _ in range(5):
            px=x+rr.randrange(8); py=y+rr.randrange(8)
            col=I(0,4 if rr.random()<.7 else 5)
            d.point((px,py),fill=col)
            if rr.random()<.25 and px<x+7: d.point((px+1,py),fill=I(0,2))

# organic river with shoreline
def river_center(y):
    return int(164 + 20*math.sin(y/25.0) + 9*math.sin(y/8.5))
for y in range(0,168):
    c=river_center(y)
    half=22 + int(4*math.sin(y/15.0))
    l=max(0,c-half); r=min(319,c+half)
    # bank
    d.line([l-3,y,r+3,y],fill=I(0,7))
    d.line([l-2,y,r+2,y],fill=I(0,6))
    # water
    d.line([l,y,r,y],fill=I(0,9 if (y//3)%2 else 8))
    if y%4==1:
        for sx in range(l+3,r-2,13):
            d.line([sx,y,min(sx+6,r),y],fill=I(0,10))
    if y%11==3:
        for sx in range(l+8,r-4,29):
            d.point((sx,y),fill=I(0,11))

# roads, with noisy shoulders
def road_poly(points,width=11):
    d.line(points, fill=I(0,6), width=width)
    d.line(points, fill=I(0,7), width=max(2,width-5))
road_poly([(0,104),(55,96),(102,108),(137,102)],11)
road_poly([(215,134),(265,126),(319,132)],11)
road_poly([(18,0),(26,33),(52,54),(76,65)],9)
road_poly([(291,0),(281,34),(298,64),(319,76)],9)

# brick wall helper
def brick_wall(x,y,w,h):
    d.rectangle([x,y,x+w-1,y+h-1],fill=I(0,12))
    for yy in range(y,y+h,4):
        d.line([x,yy,x+w-1,yy],fill=I(0,13))
        off=4 if ((yy-y)//4)&1 else 0
        for xx in range(x+off,y*0+x+w,8):
            if x<=xx<x+w: d.line([xx,yy,xx, min(yy+3,y+h-1)],fill=I(0,15))
def steel_block(x,y,w,h):
    d.rectangle([x,y,x+w-1,y+h-1],fill=I(0,15))
    d.rectangle([x+2,y+2,x+w-3,y+h-3],fill=I(0,6))
    d.line([x+2,y+2,x+w-3,y+2],fill=I(0,15))
    d.line([x+2,y+2,x+2,y+h-3],fill=I(0,15))


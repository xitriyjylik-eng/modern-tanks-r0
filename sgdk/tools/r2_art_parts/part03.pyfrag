# tree clusters
def tree(cx,cy,r=6):
    d.rectangle([cx-1,cy+2,cx+1,cy+6],fill=I(0,7))
    d.ellipse([cx-r,cy-r,cx+r,cy+r],fill=I(0,2))
    d.ellipse([cx-r+1,cy-r,cx+r-2,cy+r-2],fill=I(0,4))
    d.ellipse([cx-r+2,cy-r+1,cx+2,cy+2],fill=I(0,5))
    d.point((cx-r+2,cy),fill=I(0,1))
for cluster in [(26,26),(82,35),(24,128),(78,151),(289,104),(301,154),(255,19),(63,92)]:
    cx,cy=cluster
    for ox,oy in [(-7,-5),(3,-7),(8,1),(-3,6)]:
        tree(cx+ox,cy+oy,5)

# craters with rubble
def crater(cx,cy,r=7):
    d.ellipse([cx-r,cy-r,cx+r,cy+r],fill=I(0,6))
    d.ellipse([cx-r+2,cy-r+2,cx+r-2,cy+r-2],fill=I(0,1))
    d.ellipse([cx-2,cy-1,cx+3,cy+2],fill=I(0,0))
    for a in range(0,360,45):
        rr=r+2
        x=int(cx+math.cos(math.radians(a))*rr); y=int(cy+math.sin(math.radians(a))*rr)
        if 0<=x<W and 0<=y<168: d.point((x,y),fill=I(0,7))
for p in [(39,66),(73,119),(246,91),(294,57),(20,157),(273,151)]:
    crater(*p)

# Reference-driven tank renderer.
# These are hand-drawn native pixel models based on the locked
# TANKS_DETAILED_REFERENCE.png art direction, not geometric icon stand-ins.
def _tp(cx,cy,x,y,rot):
    if rot==0: return (cx+x,cy+y)
    if rot==1: return (cx-y,cy+x)
    if rot==2: return (cx-x,cy-y)
    return (cx+y,cy-x)

def _tpoly(cx,cy,pts,rot,fill=None,outline=None):
    d.polygon([_tp(cx,cy,x,y,rot) for x,y in pts],fill=fill,outline=outline)

def _tline(cx,cy,pts,rot,fill,width=1):
    d.line([_tp(cx,cy,x,y,rot) for x,y in pts],fill=fill,width=width)

def _trect(cx,cy,x0,y0,x1,y1,rot,fill=None,outline=None):
    _tpoly(cx,cy,[(x0,y0),(x1,y0),(x1,y1),(x0,y1)],rot,fill,outline)

def _tellipse(cx,cy,x0,y0,x1,y1,rot,fill=None,outline=None):
    if rot&1:
        box=[cx-y1,cy+x0,cx-y0,cy+x1]
    else:
        box=[cx+x0,cy+y0,cx+x1,cy+y1]
    d.ellipse(box,fill=fill,outline=outline)

def ref_tank(cx,cy,kind=0,rot=0,pal=0):
    # T-1 scout, T-2 ranger, T-3 fortress, T-4 assault.
    if pal==0:
        colors=[(4,5,3),(9,11,8),(7,15,6),(12,14,13)]
        metal_idx=15; tread_idx=6
    else:
        colors=[(10,11,6),(12,13,5),(15,9,7),(14,9,8)]
        metal_idx=9; tread_idx=5
    b,h,s=colors[kind]
    body=I(pal,b); hi=I(pal,h); shade=I(pal,s)
    dark=I(pal,1); track=I(pal,0); tread=I(pal,tread_idx); metal=I(pal,metal_idx)

    dims=[(6,9,10),(8,10,12),(10,11,14),(9,10,13)]
    w,front,rear=dims[kind]
    track_w=3 if kind<2 else 4

    # Separate caterpillar assemblies, with tread segmentation.
    for side in (-1,1):
        anchor=side*(w+4)
        if side<0: x0,x1=anchor-track_w+1,anchor
        else: x0,x1=anchor,anchor+track_w-1
        _trect(cx,cy,x0,-front,x1,rear,rot,fill=track)
        for yy in range(-front+1,rear,4):
            _tline(cx,cy,[(x0,yy),(x1,yy)],rot,tread)

    # Class-specific armoured hull silhouette.
    if kind==0:
        hull=[(-w+2,-front),(w-2,-front),(w,-front+4),(w-1,rear-2),(w-4,rear),(-w+4,rear),(-w+1,rear-2),(-w,-front+4)]
    elif kind==1:
        hull=[(-w+2,-front),(w-2,-front),(w,-front+3),(w,rear-3),(w-3,rear),(-w+3,rear),(-w,rear-3),(-w,-front+3)]
    elif kind==2:
        hull=[(-w+3,-front),(w-3,-front),(w,-front+3),(w,rear-2),(w-2,rear),(-w+2,rear),(-w,rear-2),(-w,-front+3)]
    else:
        hull=[(-w+3,-front),(w-3,-front),(w,-front+5),(w-2,rear),(0,rear-2),(-w+2,rear),(-w,-front+5)]
    _tpoly(cx,cy,hull,rot,fill=body)
    _tline(cx,cy,[(-w+3,-front+1),(w-3,-front+1)],rot,hi)
    _tline(cx,cy,[(-w+1,-front+4),(-w+2,rear-3)],rot,shade)
    _tline(cx,cy,[(w-1,-front+4),(w-2,rear-3)],rot,dark)

    # Rear deck and recognisable class modules.
    if kind==0:
        _trect(cx,cy,-4,5,4,9,rot,fill=shade)
        for xx in (-3,0,3): _tline(cx,cy,[(xx,6),(xx,8)],rot,hi)
    elif kind==1:
        _trect(cx,cy,-5,6,5,10,rot,fill=shade)
        _tline(cx,cy,[(-4,7),(4,7)],rot,hi)
        _trect(cx,cy,-w,0,-w+3,7,rot,fill=shade)
        _trect(cx,cy,w-3,0,w,7,rot,fill=shade)
    elif kind==2:
        _trect(cx,cy,-7,5,7,11,rot,fill=shade)
        for xx in (-5,-2,2,5): _tline(cx,cy,[(xx,6),(xx,10)],rot,dark)
        _trect(cx,cy,-w,-4,-w+3,7,rot,fill=shade)
        _trect(cx,cy,w-3,-4,w,7,rot,fill=shade)
    else:
        _tpoly(cx,cy,[(-w,-3),(-w+4,-7),(-4,2),(-w+2,7)],rot,fill=shade)
        _tpoly(cx,cy,[(w,-3),(w-4,-7),(4,2),(w-2,7)],rot,fill=shade)
        _trect(cx,cy,-5,6,5,10,rot,fill=dark)

    # Turret ring and shaped turret armour.
    tr=[4,5,6,5][kind]
    _tellipse(cx,cy,-tr-1,-tr-1,tr+1,tr+1,rot,fill=dark)
    if kind==2:
        turret=[(-tr+1,-tr),(tr-1,-tr),(tr+1,-2),(tr,4),(3,tr),(-3,tr),(-tr,4),(-tr-1,-2)]
    elif kind==3:
        turret=[(-tr+1,-tr),(tr-1,-tr),(tr+1,-1),(tr-1,tr),(-tr+1,tr),(-tr-1,-1)]
    else:
        turret=[(-tr+1,-tr),(tr-1,-tr),(tr,-2),(tr-1,tr),(-tr+1,tr),(-tr,-2)]
    _tpoly(cx,cy,turret,rot,fill=body)
    _tline(cx,cy,[(-tr+2,-tr+1),(tr-2,-tr+1)],rot,hi)

    # Mantlet + long gun, matching the vertical demonstrator silhouettes.
    gunlen=[13,14,12,15][kind]
    gunw=1 if kind<2 else 2
    _trect(cx,cy,-gunw,-tr-3,gunw,-tr+1,rot,fill=shade)
    _trect(cx,cy,-gunw,-tr-gunlen,gunw,-tr-3,rot,fill=hi)
    _tline(cx,cy,[(-gunw,-tr-gunlen),(gunw,-tr-gunlen)],rot,dark)

    # Cupola, hatch, bolts and front lamps.
    _tellipse(cx,cy,-2,0,2,4,rot,fill=shade)
    _tline(cx,cy,[(-1,1),(1,1)],rot,metal)
    for px,py in [(-tr+1,1),(tr-1,1),(-2,-2),(2,-2)]:
        qx,qy=_tp(cx,cy,px,py,rot)
        if 0<=qx<W and 0<=qy<H: d.point((qx,qy),fill=metal)
    for px in (-w+3,w-3):
        qx,qy=_tp(cx,cy,px,-front+4,rot)
        if 0<=qx<W and 0<=qy<H: d.point((qx,qy),fill=metal)


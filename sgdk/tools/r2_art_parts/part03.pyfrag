    (267,40,I(0,3),I(0,5),2,1),
    (308,142,I(0,12),I(0,14),3,3),
]:
    btank(*args)

# projectiles, muzzle flashes and smoke
def flash(x,y):
    for r,c in [(6,I(0,13)),(4,I(0,14)),(2,I(0,15))]:
        d.rectangle([x-r,y-r,x+r,y+r],fill=c)
    d.line([x-10,y,x+10,y],fill=I(0,15))
    d.line([x,y-8,x,y+8],fill=I(0,14))
for x,y in [(37,86),(269,95),(72,34),(308,126)]:
    flash(x,y)

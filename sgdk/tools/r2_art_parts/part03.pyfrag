# tree clusters
def tree(cx,cy,r=6):
    d.rectangle([cx-1,cy+2,cx+1,cy+6],fill=I(0,7))
    d.ellipse([cx-r,cy-r,cx+r,cy+r],fill=I(0,2))
    d.ellipse([cx-r+1,cy-r,cx+r-2,cy+r-2],fill=I(0,4))
    d.ellipse([cx-r+2,cy-r+1,cx+2,cy+2],fill=I(0,5))
    d.point((cx-r+2,cy),fill=I(0,1))
for cluster in [(26,26),(82,35),(24,128),(78,151),(289,104),(301,154),(255,19),(63,92)]:
    cx,cy=cluster
    for ox,oy in [(-7,-5),(3,-7),(8,1),(-3,6)]:
        tree(cx+ox,cy+oy,5)

# craters with rubble
def crater(cx,cy,r=7):
    d.ellipse([cx-r,cy-r,cx+r,cy+r],fill=I(0,6))
    d.ellipse([cx-r+2,cy-r+2,cx+r-2,cy+r-2],fill=I(0,1))
    d.ellipse([cx-2,cy-1,cx+3,cy+2],fill=I(0,0))
    for a in range(0,360,45):
        rr=r+2
        x=int(cx+math.cos(math.radians(a))*rr); y=int(cy+math.sin(math.radians(a))*rr)
        if 0<=x<W and 0<=y<168: d.point((x,y),fill=I(0,7))
for p in [(39,66),(73,119),(246,91),(294,57),(20,157),(273,151)]:
    crater(*p)

# compact detailed top-down battlefield tanks.
# Art direction follows TANKS_DETAILED_REFERENCE: visible tracks, shaped hull,
# turret ring, hatch/bolts and a real gun barrel rather than a rectangle icon.
def btank(cx,cy,body,hi,dir=3,variant=0):
    def P(dx,dy):
        if dir==3: return (cx+dx,cy+dy)       # up
        if dir==1: return (cx-dx,cy-dy)       # down
        if dir==0: return (cx-dy,cy+dx)       # right
        return (cx+dy,cy-dx)                  # left
    w=[5,6,7,6][variant&3]
    outer=w+3
    dark=I(0,1); track=I(0,0); metal=I(0,11); shine=I(0,15)
    # separated caterpillar tracks
    d.polygon([P(-outer,-7),P(-w,-7),P(-w,7),P(-outer,7)],fill=track)
    d.polygon([P(w,-7),P(outer,-7),P(outer,7),P(w,7)],fill=track)
    for yy in (-5,-1,3,6):
        d.line([P(-outer+1,yy),P(-w-1,yy)],fill=metal)
        d.line([P(w+1,yy),P(outer-1,yy)],fill=metal)
    # tapered armoured hull
    hull=[(-w+1,-6),(w-1,-6),(w,-3),(w,5),(w-2,7),(-w+2,7),(-w,5),(-w,-3)]
    d.polygon([P(x,y) for x,y in hull],fill=body)
    d.line([P(-w+2,-5),P(w-2,-5)],fill=hi)
    d.line([P(-w+1,-3),P(-w+1,4)],fill=hi)
    # class-specific side armour / engine deck
    if variant==1:
        d.polygon([P(-w,0),P(-w+2,-2),P(-w+2,5),P(-w,4)],fill=metal)
        d.polygon([P(w,0),P(w-2,-2),P(w-2,5),P(w,4)],fill=metal)
    elif variant==2:
        d.rectangle([min(P(-w+1,3)[0],P(w-1,6)[0]),min(P(-w+1,3)[1],P(w-1,6)[1]),max(P(-w+1,3)[0],P(w-1,6)[0]),max(P(-w+1,3)[1],P(w-1,6)[1])],fill=metal)
    elif variant==3:
        d.polygon([P(-w,-2),P(-2,-5),P(-2,4),P(-w+1,5)],fill=hi)
        d.polygon([P(w,-2),P(2,-5),P(2,4),P(w-1,5)],fill=hi)
    # turret ring and turret
    d.ellipse([cx-4,cy-4,cx+4,cy+4],fill=dark)
    d.ellipse([cx-3,cy-3,cx+3,cy+3],fill=body)
    d.line([P(-2,-2),P(2,-2)],fill=hi)
    d.rectangle([cx-1,cy-1,cx+1,cy+1],fill=metal)
    d.point((cx,cy),fill=shine)
    # mantlet + long gun
    d.line([P(0,-3),P(0,-12 if variant!=2 else -10)],fill=hi,width=2 if variant!=2 else 3)
    d.point(P(0,-12 if variant!=2 else -10),fill=shine)
    # tiny headlights / bolts
    for px,py in [(-w+2,-4),(w-2,-4),(-w+2,4),(w-2,4)]:
        d.point(P(px,py),fill=shine)

for args in [
    (22,86,I(0,4),I(0,5),0,0),
    (72,18,I(0,12),I(0,14),1,1),

# icons
def icon_tank(x,y,sel=False):
    c=I(2,11 if sel else 7); hi=I(2,9 if sel else 8)
    d.rectangle([x+2,y+5,x+11,y+10],fill=c)
    d.rectangle([x+4,y+2,x+8,y+6],fill=hi)
    d.rectangle([x+8,y+4,x+14,y+5],fill=hi)
    d.line([x+2,y+11,x+11,y+11],fill=I(2,1))
def icon_wrench(x,y,sel=False):
    c=I(2,13 if sel else 8)
    d.line([x+3,y+11,x+11,y+3],fill=c,width=2)
    d.rectangle([x+1,y+10,x+4,y+13],fill=c)
    d.rectangle([x+10,y+1,x+13,y+4],fill=c)
    d.point((x+11,y+2),fill=I(2,1))

AL3 --------
# The old T-1..T-4/stat/minimap strip was decorative only and consumed a quarter
# of the screen.  By owner direction, R2 now keeps the main menu focused and
# uses the whole lower area as battlefield art.  Garage owns class selection;
# mission/battle screens own maps and combat parameters.
for ty in range(21,28):
    for tx in range(40):
        x,y=tx*8,ty*8
        base=I(3,3 if (tx+ty)%3 else 4)
        d.rectangle([x,y,x+7,y+7],fill=base)
        rr=random.Random((tx+41)*7919 ^ (ty+5)*104729 ^ 0x5232)
        for _ in range(5):
            px=x+rr.randrange(8); py=y+rr.randrange(8)
            col=I(3,10 if rr.random()<0.65 else 6)
            d.point((px,py),fill=col)
            if rr.random()<0.22 and px<x+7:
                d.point((px+1,py),fill=I(3,11))

# Continue the river naturally through the former HUD area.
for y in range(168,224):
    c=river_center(y)
    half=22 + int(4*math.sin(y/15.0))
    l=max(0,c-half); r=min(319,c+half)
    d.line([l-3,y,r+3,y],fill=I(3,6))
    d.line([l-2,y,r+2,y],fill=I(3,5))
    d.line([l,y,r,y],fill=I(3,12 if (y//3)&1 else 13))
    if y%4==1:
        for sx in range(l+3,r-2,13):
            d.line([sx,y,min(sx+6,r),y],fill=I(3,13))

# Dirt roads feeding the lower battlefield.
d.line([(0,205),(52,194),(94,199),(124,191)],fill=I(3,5),width=11)
d.line([(0,205),(52,194),(94,199),(124,191)],fill=I(3,6),width=6)
d.line([(223,196),(272,185),(319,190)],fill=I(3,5),width=11)
d.line([(223,196),(272,185),(319,190)],fill=I(3,6),width=6)

# Tree clusters and rubble continue the same world instead of a separate panel.
for cx,cy in [(15,177),(80,214),(270,216),(307,174)]:
    d.rectangle([cx-1,cy+2,cx+1,min(cy+6,223)],fill=I(3,6))
    d.ellipse([cx-7,cy-7,cx+7,cy+7],fill=I(3,10))
    d.ellipse([cx-5,cy-6,cx+5,cy+5],fill=I(3,11))
    d.ellipse([cx-3,cy-4,cx+2,cy+2],fill=I(3,6))
for cx,cy in [(37,218),(235,178),(300,209)]:
    d.ellipse([cx-7,cy-7,cx+7,cy+7],fill=I(3,5))
    d.ellipse([cx-4,cy-4,cx+4,cy+4],fill=I(3,1))
    d.point((cx-5,cy-2),fill=I(3,7)); d.point((cx+6,cy+3),fill=I(3,7))

# Hand-drawn player-class silhouettes, now part of the battlefield rather than UI cards.
# Their scale is intentionally larger than the old icons so hull/track/turret detail survives 320x224.
ref_tank(55,197,0,0,3)
ref_tank(110,185,1,1,3)
ref_tank(250,201,2,0,3)
ref_tank(292,180,3,3,3)

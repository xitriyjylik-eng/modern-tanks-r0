# -------- enforce palette owner per tile --------
allrgb=[c for pal in pals for c in pal]
pix=img.load()
for ty in range(28):
    for tx in range(40):
        p=owner[ty][tx]
        allowed=pals[p]
        for yy in range(ty*8,min(ty*8+8,H)):
            for xx in range(tx*8,min(tx*8+8,W)):
                old=pix[xx,yy]
                oldrgb=allrgb[old] if old<64 else (0,0,0)
                if old//16 != p:
                    best=min(range(16),key=lambda i:sum((allowed[i][k]-oldrgb[k])**2 for k in range(3)))
                    pix[xx,yy]=I(p,best)

img.save(os.path.join(OUT,"r2_menu_bg.png"), optimize=False)

# Selector overlays, 104x16, PAL2. Transparent index 0.
# This is the only recurring menu animation: a subtle selection pulse.
for n,lab in enumerate(labels):
    ov=Image.new("P",(104,16),I(2,0)); ov.putpalette(palette)
    od=ImageDraw.Draw(ov)
    global_d=d
    d=od
    od.rectangle([0,0,103,15],fill=I(2,2),outline=I(2,13))
    od.rectangle([2,2,101,13],outline=I(2,12))
    od.polygon([(2,8),(7,3),(7,13)],fill=I(2,13))
    od.polygon([(101,8),(96,3),(96,13)],fill=I(2,13))
    icons[n](5,1,True)
    tx=25 if n<2 else (20 if n==2 else 17)
    ptext(tx,4,lab,I(2,13),1,1,shadow=I(2,1),shadow_off=(1,1))
    d=global_d
    ov.save(os.path.join(OUT,f"r2_sel_{n}.png"), optimize=False)

print("generated", OUT)
